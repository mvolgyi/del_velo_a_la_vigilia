  "flags": {
    "del-velo-a-la-vigilia": {
      "origen": "escena",
      "escena": "somnia-planta-vieja",
      "nota": "El ala antigua de la clínica: terrazo gastado, cañerías vistas, consultorios abandonados. La entrada es por el oeste, desde la pesada puerta de la planta nueva (región). Durante el apagón la única luz es la del rack prohibido, que sigue al máximo. El Limpiador sabe qué baldosas crujen y qué pasillos de mantenimiento no tienen cámaras. Al sur, la puerta de piedra de la que venían los rezos: detrás, la escalera baja al pasillo lateral de la cripta (región). Muebles móviles NO pintados (colocarlos como tiles): palet.",
      "plano": "somnia-planta-vieja",
      "provisional": false
    }
